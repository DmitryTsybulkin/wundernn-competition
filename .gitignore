# Datasets — 29 GB train, 5.6 GB valid, subsets. Never commit.
datasets/
*.parquet

# Cached predictions and other large intermediates
tools/_*.npz
tools/_*.npy
*.npy

# Checkpoints: every per-run file is small (~1-5 MB) and is committed, INCLUDING
# runs/*/ckpt_latest.pt (resumable-training state, notes/TASK_gpu_prep.md): the Colab
# notebook pushes it back so an interrupted run can continue from anywhere.
# (Until 2026-09-21 ckpt_latest.pt was ignored; changed because the task requires it.)
runs/*/wandb/
runs/*/*.tmp

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.ipynb_checkpoints/

# OS / editor
.DS_Store
.idea/
.vscode/

# Secrets — never commit tokens or credentials
.env
*.token
secrets.json

# Local Claude Code state
.claude/
